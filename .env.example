# PostgreSQL connection string (local or hosted: Neon, Supabase, Vercel Postgres, RDS ...)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# First Super Administrator — created automatically ONLY when the users table is empty.
# Change the password after first login (top-right menu → Change password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@epiups.local

# Public origin used in password-reset links (optional; defaults to the request origin)
APP_URL=http://localhost:3000

# Secret for the scheduled backup endpoint GET /api/cron/backup (send "Authorization: Bearer <secret>")
CRON_SECRET=change-me-to-a-long-random-string
